# Salin ke .env (lokal, di luar Docker). Nilai default di config.py pakai localhost.
APP_NAME=corebank-api
APP_ENV=dev
LOG_LEVEL=INFO

# Dalam Docker, compose menimpa nilai ini dengan hostname service (postgres, redis, rabbitmq)
DATABASE_URL=postgresql+psycopg://corebank:corebank@localhost:5432/corebank
REDIS_URL=redis://localhost:6379/0
AMQP_URL=amqp://guest:guest@localhost:5672/

# Auth — generate sendiri: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-only-secret-ganti-di-produksi
